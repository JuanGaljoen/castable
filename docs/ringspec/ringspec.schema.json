{
  "$defs": {
    "FieldConfidence": {
      "additionalProperties": false,
      "description": "Per-field vision confidence (0..1), filled by the photo classifier; None\nwhere vision gave no estimate.",
      "properties": {
        "inner_diameter": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inner Diameter"
        },
        "band_width": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Width"
        },
        "band_thickness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Thickness"
        },
        "stone_diameter": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stone Diameter"
        },
        "stone_height": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stone Height"
        },
        "prong_count": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prong Count"
        },
        "setting_height": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setting Height"
        }
      },
      "title": "FieldConfidence",
      "type": "object"
    },
    "Halo": {
      "additionalProperties": false,
      "description": "Accent stones around the centre stone. Whether they fit is checked by\nthe castability gate, not here.",
      "properties": {
        "halo_stone_diameter": {
          "default": 1.3,
          "maximum": 2.5,
          "minimum": 0.9,
          "title": "Halo Stone Diameter",
          "type": "number"
        },
        "halo_stone_count": {
          "default": 14,
          "maximum": 24,
          "minimum": 8,
          "title": "Halo Stone Count",
          "type": "integer"
        },
        "halo_gap": {
          "default": 0.5,
          "maximum": 1.5,
          "minimum": 0.3,
          "title": "Halo Gap",
          "type": "number"
        },
        "halo_stone_height": {
          "default": 1.2,
          "maximum": 3.0,
          "minimum": 0.8,
          "title": "Halo Stone Height",
          "type": "number"
        }
      },
      "title": "Halo",
      "type": "object"
    },
    "Motif": {
      "additionalProperties": false,
      "description": "Decorative element placeholder.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Motif",
      "type": "object"
    },
    "Setting": {
      "additionalProperties": false,
      "description": "Prong count and setting height.",
      "properties": {
        "prong_count": {
          "enum": [
            4,
            6
          ],
          "title": "Prong Count",
          "type": "integer"
        },
        "setting_height": {
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Setting Height",
          "type": "number"
        }
      },
      "required": [
        "prong_count",
        "setting_height"
      ],
      "title": "Setting",
      "type": "object"
    },
    "Shank": {
      "additionalProperties": false,
      "description": "Band geometry. `shank_taper` is the width flare toward the head.\n\nThe outer and inner profiles are independent because the trade treats them\nthat way (docs/research/shank-cross-section-profiles.md). Both default to\n`domed`, a classic court band.",
      "properties": {
        "inner_diameter": {
          "exclusiveMinimum": 0,
          "maximum": 40,
          "title": "Inner Diameter",
          "type": "number"
        },
        "band_width": {
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Band Width",
          "type": "number"
        },
        "band_thickness": {
          "exclusiveMinimum": 0,
          "maximum": 8,
          "title": "Band Thickness",
          "type": "number"
        },
        "shank_taper": {
          "default": 1.35,
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Shank Taper",
          "type": "number"
        },
        "outer_profile": {
          "default": "domed",
          "enum": [
            "domed",
            "flat",
            "knife_edge"
          ],
          "title": "Outer Profile",
          "type": "string"
        },
        "inner_profile": {
          "default": "domed",
          "enum": [
            "domed",
            "flat"
          ],
          "title": "Inner Profile",
          "type": "string"
        }
      },
      "required": [
        "inner_diameter",
        "band_width",
        "band_thickness"
      ],
      "title": "Shank",
      "type": "object"
    },
    "SideStone": {
      "additionalProperties": false,
      "description": "Channel-set accent row down each shoulder. Only channel retention\nexists so far; \"pave\" is rejected rather than built wrong.",
      "properties": {
        "accent_stone_diameter": {
          "default": 1.5,
          "maximum": 2.5,
          "minimum": 0.9,
          "title": "Accent Stone Diameter",
          "type": "number"
        },
        "accent_stone_height": {
          "default": 1.2,
          "maximum": 3.0,
          "minimum": 0.8,
          "title": "Accent Stone Height",
          "type": "number"
        },
        "accent_count_per_side": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Accent Count Per Side",
          "type": "integer"
        },
        "accent_gap": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.2,
          "title": "Accent Gap",
          "type": "number"
        },
        "retention": {
          "const": "channel",
          "default": "channel",
          "title": "Retention",
          "type": "string"
        }
      },
      "title": "SideStone",
      "type": "object"
    },
    "Stones": {
      "additionalProperties": false,
      "description": "Centre stone size and shape.\n\n`stone_diameter` is the SHORT axis; the long axis is\n`stone_diameter * length_ratio`. A ratio, not a length, because a ratio is\nwhat a photo shows. Defaults mean a round stone.",
      "properties": {
        "stone_diameter": {
          "exclusiveMinimum": 0,
          "maximum": 24,
          "title": "Stone Diameter",
          "type": "number"
        },
        "stone_height": {
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Stone Height",
          "type": "number"
        },
        "shape": {
          "default": "round",
          "enum": [
            "round",
            "oval",
            "cushion",
            "emerald",
            "pear",
            "marquise"
          ],
          "title": "Shape",
          "type": "string"
        },
        "length_ratio": {
          "default": 1.0,
          "maximum": 2.5,
          "minimum": 1.0,
          "title": "Length Ratio",
          "type": "number"
        }
      },
      "required": [
        "stone_diameter",
        "stone_height"
      ],
      "title": "Stones",
      "type": "object"
    },
    "Trilogy": {
      "additionalProperties": false,
      "description": "Side-stone group flanking the centre stone.",
      "properties": {
        "side_stone_diameter": {
          "default": 2.5,
          "maximum": 6.0,
          "minimum": 0.9,
          "title": "Side Stone Diameter",
          "type": "number"
        },
        "side_stone_height": {
          "default": 1.8,
          "maximum": 4.0,
          "minimum": 0.8,
          "title": "Side Stone Height",
          "type": "number"
        },
        "side_stone_gap": {
          "default": 0.6,
          "maximum": 2.0,
          "minimum": 0.3,
          "title": "Side Stone Gap",
          "type": "number"
        }
      },
      "title": "Trilogy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A ring: a base (shank, setting, stones) plus any mix of optional\nfeatures. Whether the features fit together is the gate's job.",
  "properties": {
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "shank": {
      "$ref": "#/$defs/Shank"
    },
    "setting": {
      "$ref": "#/$defs/Setting"
    },
    "stones": {
      "$ref": "#/$defs/Stones"
    },
    "halo": {
      "anyOf": [
        {
          "$ref": "#/$defs/Halo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trilogy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trilogy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "side_stone": {
      "anyOf": [
        {
          "$ref": "#/$defs/SideStone"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "motifs": {
      "items": {
        "$ref": "#/$defs/Motif"
      },
      "title": "Motifs",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldConfidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "shank",
    "setting",
    "stones"
  ],
  "title": "RingSpec",
  "type": "object"
}
