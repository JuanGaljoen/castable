{
  "$defs": {
    "FieldConfidence": {
      "additionalProperties": false,
      "description": "Per-field vision confidence (0..1), filled by the photo classifier; None\nwhere vision gave no estimate.",
      "properties": {
        "inner_diameter": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inner Diameter"
        },
        "band_width": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Width"
        },
        "band_thickness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Thickness"
        },
        "stone_diameter": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stone Diameter"
        },
        "stone_height": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stone Height"
        },
        "prong_count": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prong Count"
        },
        "setting_height": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setting Height"
        }
      },
      "title": "FieldConfidence",
      "type": "object"
    },
    "Halo": {
      "additionalProperties": false,
      "description": "Accent-stone ring encircling the centre stone.\n\nHow many accents actually fit depends on the centre stone the halo rides,\nnot on this range alone: each seat needs metal either side of it. That is\n`_halo_web`'s job, not the schema's.",
      "properties": {
        "halo_stone_diameter": {
          "default": 1.3,
          "maximum": 2.5,
          "minimum": 0.9,
          "title": "Halo Stone Diameter",
          "type": "number"
        },
        "halo_stone_count": {
          "default": 14,
          "maximum": 24,
          "minimum": 8,
          "title": "Halo Stone Count",
          "type": "integer"
        },
        "halo_gap": {
          "default": 0.5,
          "maximum": 1.5,
          "minimum": 0.3,
          "title": "Halo Gap",
          "type": "number"
        },
        "halo_stone_height": {
          "default": 1.2,
          "maximum": 3.0,
          "minimum": 0.8,
          "title": "Halo Stone Height",
          "type": "number"
        }
      },
      "title": "Halo",
      "type": "object"
    },
    "Motif": {
      "additionalProperties": false,
      "description": "Decorative element placeholder (empty list is valid for a solitaire).",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Motif",
      "type": "object"
    },
    "Setting": {
      "additionalProperties": false,
      "description": "Prong/gallery group. prong_count is a strict 4-or-6 literal.",
      "properties": {
        "prong_count": {
          "enum": [
            4,
            6
          ],
          "title": "Prong Count",
          "type": "integer"
        },
        "setting_height": {
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Setting Height",
          "type": "number"
        }
      },
      "required": [
        "prong_count",
        "setting_height"
      ],
      "title": "Setting",
      "type": "object"
    },
    "Shank": {
      "additionalProperties": false,
      "description": "Band geometry. `shank_taper` is the WIDTH flare toward the head (the SCAD\n8th shaping param); thickness is governed by `SHANK_THICKNESS_TAPER`.\n\n`outer_profile`/`inner_profile` are the cross-section family: two\nindependent axes, not one enum of trade names, because the trade itself\ntreats them independently (docs/research/shank-cross-section-profiles.md).\nBoth default to `domed`, i.e. \"court\" -- the plain `Ellipse` section -- so a\nspec that omits them gets the court band. See\n`ringcad.ringspec.sections` for what each value means geometrically.",
      "properties": {
        "inner_diameter": {
          "exclusiveMinimum": 0,
          "maximum": 40,
          "title": "Inner Diameter",
          "type": "number"
        },
        "band_width": {
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Band Width",
          "type": "number"
        },
        "band_thickness": {
          "exclusiveMinimum": 0,
          "maximum": 8,
          "title": "Band Thickness",
          "type": "number"
        },
        "shank_taper": {
          "default": 1.35,
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Shank Taper",
          "type": "number"
        },
        "outer_profile": {
          "default": "domed",
          "enum": [
            "domed",
            "flat",
            "knife_edge"
          ],
          "title": "Outer Profile",
          "type": "string"
        },
        "inner_profile": {
          "default": "domed",
          "enum": [
            "domed",
            "flat"
          ],
          "title": "Inner Profile",
          "type": "string"
        }
      },
      "required": [
        "inner_diameter",
        "band_width",
        "band_thickness"
      ],
      "title": "Shank",
      "type": "object"
    },
    "SideStone": {
      "additionalProperties": false,
      "description": "Channel-set accent row down each shoulder of the shank.\n\n`retention` is a Literal[\"channel\"] in v1 \u2014 pave is a future value; a\n\"pave\" spec is a clean schema rejection today, not a shipped-but-broken\noption.",
      "properties": {
        "accent_stone_diameter": {
          "default": 1.5,
          "maximum": 2.5,
          "minimum": 0.9,
          "title": "Accent Stone Diameter",
          "type": "number"
        },
        "accent_stone_height": {
          "default": 1.2,
          "maximum": 3.0,
          "minimum": 0.8,
          "title": "Accent Stone Height",
          "type": "number"
        },
        "accent_count_per_side": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Accent Count Per Side",
          "type": "integer"
        },
        "accent_gap": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.2,
          "title": "Accent Gap",
          "type": "number"
        },
        "retention": {
          "const": "channel",
          "default": "channel",
          "title": "Retention",
          "type": "string"
        }
      },
      "title": "SideStone",
      "type": "object"
    },
    "Stones": {
      "additionalProperties": false,
      "description": "Centre-stone sizing and shape for the seat module.\n\n`stone_diameter` is the SHORT axis (the width); the long axis is\n`stone_diameter * length_ratio`. Both shape fields are defaulted, so a spec\nwithout them is valid and means a round stone.\n\nA ratio rather than an explicit length: it is the quantity a photo actually\nshows (so vision can estimate it), and `length_ratio == 1.0` makes round\nfall out of the same code path instead of needing a branch. The 2.5 cap is\na castability guard -- an ellipse's tightest bend is `semi_minor^2 /\nsemi_major`, so elongation directly thins the metal at the tips.",
      "properties": {
        "stone_diameter": {
          "exclusiveMinimum": 0,
          "maximum": 24,
          "title": "Stone Diameter",
          "type": "number"
        },
        "stone_height": {
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Stone Height",
          "type": "number"
        },
        "shape": {
          "default": "round",
          "enum": [
            "round",
            "oval",
            "cushion",
            "emerald",
            "pear",
            "marquise"
          ],
          "title": "Shape",
          "type": "string"
        },
        "length_ratio": {
          "default": 1.0,
          "maximum": 2.5,
          "minimum": 1.0,
          "title": "Length Ratio",
          "type": "number"
        }
      },
      "required": [
        "stone_diameter",
        "stone_height"
      ],
      "title": "Stones",
      "type": "object"
    },
    "Trilogy": {
      "additionalProperties": false,
      "description": "Side-stone group flanking the centre stone.",
      "properties": {
        "side_stone_diameter": {
          "default": 2.5,
          "maximum": 6.0,
          "minimum": 0.9,
          "title": "Side Stone Diameter",
          "type": "number"
        },
        "side_stone_height": {
          "default": 1.8,
          "maximum": 4.0,
          "minimum": 0.8,
          "title": "Side Stone Height",
          "type": "number"
        },
        "side_stone_gap": {
          "default": 0.6,
          "maximum": 2.0,
          "minimum": 0.3,
          "title": "Side Stone Gap",
          "type": "number"
        }
      },
      "title": "Trilogy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The versioned contract: one model, features as optional groups.\n\n`halo`/`trilogy`/`side_stone` are independently optional \u2014 a ring is a base\n(shank/setting/stones) plus whichever features are present, not a choice of\nexactly one archetype. The schema allows any subset; whether the present\nfeatures fit together is `validate_castability`'s job\n(`_cross_feature_overcrowding`).",
  "properties": {
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "shank": {
      "$ref": "#/$defs/Shank"
    },
    "setting": {
      "$ref": "#/$defs/Setting"
    },
    "stones": {
      "$ref": "#/$defs/Stones"
    },
    "halo": {
      "anyOf": [
        {
          "$ref": "#/$defs/Halo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trilogy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trilogy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "side_stone": {
      "anyOf": [
        {
          "$ref": "#/$defs/SideStone"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "motifs": {
      "items": {
        "$ref": "#/$defs/Motif"
      },
      "title": "Motifs",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldConfidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "shank",
    "setting",
    "stones"
  ],
  "title": "RingSpec",
  "type": "object"
}
